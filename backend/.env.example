# ===============================
# Runtime / Server
# ===============================
NODE_ENV=development
PORT=28444
SERVER_PORT=28444
TRUST_PROXY=false
BASE_PATH=/cnp
API_PREFIX=/api
SOCKETIO_PATH=/socket.io

# ===============================
# Frontend (CORS)
# ===============================
FRONTEND_URL=https://frontend-dev.example.local
CORS_ORIGINS=https://frontend-dev.example.local
CSRF_ORIGINS=https://frontend-dev.example.local
# Opcional cuando el API se publica en un origen distinto al frontend.
BACKEND_URL=

# ===============================
# SQL Server - VALIDACION (catalogos, solo lectura)
# ===============================
DB_SERVER_VALIDACION=q1491n2023
DB_PORT_VALIDACION=1433
VALIDACION_DATABASE=TablasComunes
DB_AUTH_VALIDACION=sql
DB_USER_VALIDACION=USUARIO_SQL_VALIDACION
DB_PASSWORD_VALIDACION=CLAVE_SQL_VALIDACION

# ===============================
# SQL Server - CONSULTA (views, solo lectura logica)
# ===============================
DB_SERVER_CONSULTA=d1491n2023
DB_PORT_CONSULTA=1433
CONSULTA_DATABASE=DBCSASPv2
DB_AUTH_CONSULTA=sql
DB_USER_CONSULTA=USUARIO_SQL_CONSULTA
DB_PASSWORD_CONSULTA=CLAVE_SQL_CONSULTA

# ===============================
# SQL Server - RECEPCION (lectura/escritura)
# ===============================
DB_SERVER_RECEPCION=d1491n2023
DB_PORT_RECEPCION=1433
RECEPCION_DATABASE=DBCSASPv2
DB_AUTH_RECEPCION=sql
DB_USER_RECEPCION=USUARIO_SQL_RECEPCION
DB_PASSWORD_RECEPCION=CLAVE_SQL_RECEPCION

# Compatibilidad temporal mientras se termina la migracion.
DB_SERVER=d1491n2023
DB_USER=USUARIO_SQL_COMPARTIDO
DB_PASSWORD=CLAVE_SQL_COMPARTIDA
DB_PORT=1433

SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_POOL_MAX=10
SQL_POOL_MIN=0
SQL_POOL_IDLE_MILLIS=30000

# Requisito pendiente de infraestructura:
# CONSULTA debe recibir credenciales realmente de solo lectura si se requiere enforcement a nivel SQL.

# ===============================
# SMTP
# ===============================
SMTP_HOST=SMTP_HOST
SMTP_PORT=2525
SMTP_USER=SMTP_USER
SMTP_PASS=SMTP_PASS
SMTP_SECURE=false
SMTP_FROM=CNP <no-reply@example.com>

# ===============================
# JWT / Auth
# ===============================
JWT_PRIVATE_KEY_PATH=secrets/es256-priv.pem
JWT_KID=val-2025-07-dev
JWT_SECRET=CAMBIAR_EN_CADA_ENTORNO

# ===============================
# Rate limiting & misc
# ===============================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOG_LEVEL=debug
FILE_UPLOAD_MAX_MB=50
