{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "build",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "build", "**/*.test.ts", "**/*.spec.ts"]
}
